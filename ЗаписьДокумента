Функция ЗаписьДокумента(ДокументОбъект, Знач РежимЗаписи = Неопределено,
									ОтключитьПроверкуЗаполнения = Ложь,
									ЗаписьВРежимеЗагрузки = Ложь,
									ЗаписатьПриОшибкеПроведения = Истина) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьОшибки", Ложь);
	Результат.Вставить("ТекстыСообщений", Новый Массив);
	Результат.Вставить("ТекстСообщений", "");
	
	ЭтоНовый = ДокументОбъект.ЭтоНовый();
	
	МассивСообщений = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСообщений, ПолучитьСообщенияПользователю(Истина));
	
	МетаОбъекта = ДокументОбъект.Метаданные();
	
	ДокументМожетПровдиться = МетаОбъекта.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить;
	
	Если ЗначениеЗаполнено(РежимЗаписи) Тогда
		//
	ИначеЕсли ДокументМожетПровдиться Тогда
		РежимЗаписи = ?(ДокументОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	Иначе
		РежимЗаписи = РежимЗаписиДокумента.Запись;
	КонецЕсли;
	
	ДокументОбъект.ОбменДанными.Загрузка = ЗаписьВРежимеЗагрузки;
	
	ДокументОбъект.ПометкаУдаления = Ложь;
		
	Если НЕ ОтключитьПроверкуЗаполнения
		И ДокументМожетПровдиться
		И РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Не ДокументОбъект.ПроверитьЗаполнение() Тогда
		
		Если ЗаписатьПриОшибкеПроведения Тогда
			
			Если ДокументОбъект.Проведен Тогда
				РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
			Иначе
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли;
				
			Попытка
				ДокументОбъект.Записать(РежимЗаписи);
			Исключение
				Результат.ТекстыСообщений.Добавить("Документ не проведен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Результат.ЕстьОшибки = Истина;
			КонецПопытки;
			
		КонецЕсли;
		
		Результат.ЕстьОшибки = Истина;
	
	ИначеЕсли НЕ ОтключитьПроверкуЗаполнения
		И НЕ ДокументМожетПровдиться
		И Не ДокументОбъект.ПроверитьЗаполнение() Тогда
		 
		 Результат.ЕстьОшибки = Истина;
		 
	Иначе
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			ДокументОбъект.ОбменДанными.Загрузка = Ложь;
		КонецЕсли;
		
		Попытка
			ДокументОбъект.Записать(РежимЗаписи);
		Исключение
			Результат.ТекстыСообщений.Добавить("Документ не проведен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат.ЕстьОшибки = Истина;			
		КонецПопытки;
		
		Если Результат.ЕстьОшибки И ДокументОбъект.Модифицированность() И Не ДокументОбъект.Проведен Тогда
			
			Попытка
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			Исключение
				Результат.ТекстыСообщений.Добавить("Документ не записан: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Результат.ЕстьОшибки = Истина;
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	СообщенияОшибки = ПолучитьСообщенияПользователю(Истина);
	
	Для Каждого Сообщение Из СообщенияОшибки Цикл
		Результат.ТекстыСообщений.Добавить(Сообщение.Текст);
	КонецЦикла;
	
	Результат.ТекстСообщений = СтрСоединить(Результат.ТекстыСообщений, Символы.ПС);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСообщений, СообщенияОшибки);
	
	Для Каждого Сообщение Из МассивСообщений Цикл
		Сообщение.Сообщить();
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // !- ИТПл Григорьев_СВ 2026-09-01
